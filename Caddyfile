{
	admin {$CADDY_ADMIN:off}
	auto_https off
	# Sin esto Caddy intenta escribir /config/caddy/autosave.json y falla con
	# permission denied: el contenedor corre como app (uid 1000). Ese autoguardado
	# solo sirve para recuperar config aplicada por la API admin, que esta off.
	persist_config off
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::3000} {
	root * {$SERVER_ROOT:/app/public}
	encode zstd br gzip

	# Access log a stdout (Apache ya lo hace): paridad entre variantes.
	log {
		output stdout
	}

	header {
		-Server
		X-Content-Type-Options nosniff
	}

	# El entrypoint deriva CADDY_MAX_SIZE de PHP_POST_MAX_SIZE para que ambas
	# variantes tengan el mismo limite de subida.
	request_body {
		max_size {$CADDY_MAX_SIZE:16MiB}
	}

	php_server {
		try_files {path} index.php
	}
}
