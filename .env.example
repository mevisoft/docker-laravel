# ---------------------------------------------------------------
# IMPORTANTE: este archivo lo leen Docker Compose y Laravel a la vez.
# No uses comillas alrededor de los valores ni # a mitad de linea:
# Compose los pasaria literales al contenedor.
# ---------------------------------------------------------------

# --- Deploy ---
GIT_REPO=acme/mi-proyecto
GIT_BRANCH=main
GITHUB_PAT=
REDEPLOY_STRATEGY=update
BUILD_ASSETS=true
RUN_MIGRATIONS=false
APP_PORT=8000
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
# QUEUE_OPTS va sin comillas a proposito: entrypoint.sh lo expande sin
# entrecomillar para que cada flag llegue como argumento separado a
# queue:work. Si le pones comillas, se pasa como un unico argumento invalido.
QUEUE_OPTS=--tries=3 --timeout=90
ENV_FILE=.env

# --- Imagen y publicacion ---
IMAGE=ghcr.io/usuario/laravel-deploy:latest
REGISTRY=ghcr.io
IMAGE_NAME=usuario/laravel-deploy
TAG=latest
PLATFORMS=linux/amd64

# --- Laravel ---
# Genera la clave con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
