# ---------------------------------------------------------------
# IMPORTANTE: este archivo lo leen Docker Compose y Laravel a la vez.
# Sin comillas por defecto, y nunca # a mitad de linea. Pero un valor que
# contenga espacios SI debe ir entrecomillado: el parser dotenv de Laravel
# rechaza espacios sin comillas, y Compose las retira antes de pasar la
# variable al contenedor, asi que llegan igual de bien con o sin ellas.
# ---------------------------------------------------------------

# --- Deploy ---
GIT_REPO=acme/mi-proyecto
GIT_BRANCH=main
GITHUB_PAT=
REDEPLOY_STRATEGY=update
BUILD_ASSETS=true
RUN_MIGRATIONS=false
APP_PORT=3000
# QUEUE_OPTS va entrecomillado porque tiene un espacio: el parser dotenv de
# Laravel rechaza un valor con espacios sin comillas (rompe composer install
# al correr artisan package:discover). Compose retira las comillas antes de
# pasar la variable al contenedor, y entrypoint.sh la expande sin comillas
# para que cada flag llegue como argumento separado a queue:work.
QUEUE_OPTS="--tries=3 --timeout=90"
ENV_FILE=.env

# --- Binarios extra (los instala el init en el volumen app_bin) ---
# ffmpeg, ffprobe y node ya vienen en la imagen. YTDLP_VERSION (tag, p. ej.
# 2026.08.19, o latest) instala yt-dlp en el init; vacio = no se instala. Cambiarla
# y redesplegar lo actualiza sin rebuild.
YTDLP_VERSION=
# Otros binarios, separados por coma:
# nombre|https://url|sha256 (sha256 obligatorio)
EXTRA_TOOLS=

# --- Imagen y publicacion ---
IMAGE=ghcr.io/usuario/laravel-deploy:latest
REGISTRY=ghcr.io
IMAGE_NAME=usuario/laravel-deploy
TAG=latest
PLATFORMS=linux/amd64

# --- Laravel ---
# Genera la clave con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
